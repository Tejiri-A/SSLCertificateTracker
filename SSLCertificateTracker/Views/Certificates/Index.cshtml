@model IEnumerable<SslCertificate>

@{
    ViewData["Title"] = "SSL Certificates";
}

<div class="container-fluid">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="display-6">
            <i class="text-primary bi bi-shield-lock"></i> SSL Certificates
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Certificate
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No SSL certificates found. 
            <a asp-action="Create" class="alert-link">Add your first certificate</a>
        </div>
    }
    else
    {
        <div class="shadow card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Domain Name</th>
                                <th>Issued Date</th>
                                <th>Re-issued Date</th>
                                <th>Expiration Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var certificate in Model)
                            {
                                var daysUntilExpiry = (certificate.ExpirationDate - DateTime.Today).Days;
                                var statusClass = "";
                                var statusText = "";
                                
                                if (daysUntilExpiry <= 7)
                                {
                                    statusClass = "danger";
                                    statusText = "Expiring Soon";
                                }
                                else if (daysUntilExpiry <= 30)
                                {
                                    statusClass = "warning";
                                    statusText = "Approaching Expiry";
                                }
                                else if (certificate.ExpirationDate < DateTime.Today)
                                {
                                    statusClass = "dark";
                                    statusText = "Expired";
                                }
                                else
                                {
                                    statusClass = "success";
                                    statusText = "Valid";
                                }
                                
                                <tr>
                                    <td>
                                        <strong>@certificate.DomainName</strong>
                                    </td>
                                    <td>@certificate.DateIssued.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (certificate.DateReissued.HasValue)
                                        {
                                            @certificate.DateReissued.Value.ToString("yyyy-MM-dd")
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>@certificate.ExpirationDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="bg-@statusClass badge">
                                            @statusText (@daysUntilExpiry days)
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@certificate.Id" 
                                               class="btn-outline-primary btn">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <form asp-action="Delete" method="post" class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this certificate?');">
                                                <input type="hidden" name="id" value="@certificate.Id" />
                                                <button type="submit" class="ms-1 btn-outline-danger btn">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Summary Card -->
        <div class="mt-4 row">
            <div class="col-md-3">
                <div class="bg-primary text-white card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-shield-check"></i> Total Certificates
                        </h5>
                        <p class="display-6">@Model.Count()</p>
                    </div>
                </div>
            </div>
            
            @{
                var expiringSoon = Model.Count(c => (c.ExpirationDate - DateTime.Today).Days <= 30);
                var expired = Model.Count(c => c.ExpirationDate < DateTime.Today);
                var valid = Model.Count(c => (c.ExpirationDate - DateTime.Today).Days > 30);
            }
            
            <div class="col-md-3">
                <div class="bg-warning text-dark card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-exclamation-triangle"></i> Expiring Soon
                        </h5>
                        <p class="display-6">@expiringSoon</p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="bg-danger text-white card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-x-circle"></i> Expired
                        </h5>
                        <p class="display-6">@expired</p>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="bg-success text-white card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-check-circle"></i> Valid
                        </h5>
                        <p class="display-6">@valid</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto-refresh page every 5 minutes to update status
        setTimeout(function() {
            window.location.reload();
        }, 300000); // 5 minutes
        
        // Tooltip initialization
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}