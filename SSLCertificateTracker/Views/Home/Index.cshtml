@model IEnumerable<SslCertificate>

@{
    ViewData["Title"] = "SSL Certificates";
}

<div class="mt-4 container">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2>SSL Certificates</h2>
        <a asp-controller="Certificates" asp-action="Create" class="btn btn-primary">Add New Certificate</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>Domain Name</th>
                    <th>Date Issued</th>
                    <th>Date Re-issued</th>
                    <th>Expiration Date</th>
                    <th>Days Until Expiry</th>
                    <th>Actions</th>
                </tr>
            </thead>
                <tbody>
                @foreach (var item in Model ?? Enumerable.Empty<SslCertificate>())
                {
                    var expiration = item.ExpirationDate;
                    var daysUntilExpiry = (int)(expiration - DateTime.UtcNow).TotalDays;

                    string rowClass = daysUntilExpiry <= 7 ? "table-danger" : daysUntilExpiry <= 30 ? "table-warning" : "";

                    <tr class="@rowClass">
                        <td>@item.DomainName</td>
                        <td>@item.DateIssued.ToShortDateString()</td>
                        <td>@(item.DateReissued?.ToShortDateString() ?? "N/A")</td>
                        <td>@expiration.ToShortDateString()</td>
                        <td>
                            <span class="badge @(daysUntilExpiry <= 7 ? "bg-danger" : daysUntilExpiry <= 30 ? "bg-warning" : "bg-success")">
                                @daysUntilExpiry
                            </span>
                        </td>
                        <td>
                            <div class="row row-cols-1 row-cols-md-2 g-2" role="group">
                                <div class="col">
                                    <a asp-controller="Certificates" asp-action="Edit" asp-route-id="@item.Id" 
                                       class="btn btn-outline-primary btn-sm w-100">Edit</a>
                                </div>
                                <div class="col">
                                    <form asp-controller="Certificates" asp-action="Delete" method="post" 
                                          onsubmit="return confirm('Delete this certificate?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
        </table>
    </div>
</div>