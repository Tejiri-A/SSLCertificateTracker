<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SSL Certificate Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .navbar-brand {
            font-weight: 600;
        }
        .table th {
            font-weight: 600;
        }
        .card {
            border-radius: 10px;
        }
    </style>
</head>
<body>
    <nav class="bg-dark navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Certificates" asp-action="Index">
                <i class="me-2 bi bi-shield-lock"></i>SSL Tracker
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-primary bg-light @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Certificates" ? "active" : "")" 
                           asp-controller="Certificates" asp-action="Index">
                            <i class="bi bi-list-ul me-1"></i>Go To Certificates Page 
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/hangfire" target="_blank">
                            <i class="bi bi-gear me-1"></i>Background Jobs
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-light">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person me-2"></i>Profile
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="mt-4 container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-5 border-top text-muted footer">
        <div class="py-3 container">
            <div class="row">
                <div class="col-md-6">
                    &copy; @DateTime.Now.Year - SSL Certificate Tracker
                </div>
                <div class="text-end col-md-6">
                    <small>Auto-checks certificates daily for expiry notifications</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>