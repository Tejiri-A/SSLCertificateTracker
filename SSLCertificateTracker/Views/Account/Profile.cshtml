@model ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="shadow card">
            <div class="bg-primary text-white card-header">
                <h4 class="mb-0"><i class="bi bi-person-circle"></i> User Profile</h4>
            </div>
            <div class="card-body">
                <form asp-action="Profile" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <h5 class="mb-3">Personal Information</h5>
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" readonly />
                        <small class="text-muted">Email cannot be changed</small>
                    </div>
                    
                    <hr class="my-4" />
                    
                    <h5 class="mb-3">Notification Settings</h5>
                    
                    <div class="mb-3">
                        <label asp-for="NotificationEmail" class="form-label"></label>
                        <input asp-for="NotificationEmail" class="form-control" />
                        <span asp-validation-for="NotificationEmail" class="text-danger"></span>
                        <small class="text-muted">This is where expiry notifications will be sent</small>
                    </div>
                    
                    <div class="mb-3 form-check">
                        <input asp-for="EnableEmailNotifications" class="form-check-input" />
                        <label asp-for="EnableEmailNotifications" class="form-check-label"></label>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="DaysBeforeExpiryToNotify" class="form-label"></label>
                        <input asp-for="DaysBeforeExpiryToNotify" type="number" class="form-control" min="1" max="90" />
                        <span asp-validation-for="DaysBeforeExpiryToNotify" class="text-danger"></span>
                        <small class="text-muted">How many days before expiry to send notifications</small>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    
                    <a asp-controller="Certificates" asp-action="Index" class="ms-2 btn-outline-secondary btn">
                        <i class="bi-arrow-left bi"></i> Back to Certificates
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}